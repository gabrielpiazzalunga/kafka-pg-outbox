@baseUrl      = https://localhost:7024
@vesselId     = c9e67852-2e78-4017-82ab-fc5977f84f7d
@mbesId       = mbes-001
@pduId        = pdu-001
@insId        = ins-001
@customerId   = 1
@projectId    = 2
@allocationId = 3

###

# ── Health ────────────────────────────────────────────────────────────────────

### Health check
GET {{baseUrl}}/health

###

# ── Vessels ───────────────────────────────────────────────────────────────────

### List vessels
GET {{baseUrl}}/api/vessels?page=1&pageSize=20

###

### Get vessel
GET {{baseUrl}}/api/vessels/{{vesselId}}

###

### Create vessel
POST {{baseUrl}}/api/vessels
Content-Type: application/json

{
  "name": "OI Horizon",
  "vesselType": "SURVEY",
  "bridgePhoneNumber": "+44-1234-567890",
  "captainEmail": "captain@oi.com",
  "surveyEmail": "survey@oi.com"
}

###

### Update vessel
PUT {{baseUrl}}/api/vessels/{{vesselId}}
Content-Type: application/json

{
  "name": "OI Horizon II",
  "vesselType": "SURVEY",
  "bridgePhoneNumber": null,
  "captainEmail": null,
  "surveyEmail": null
}

###

### Delete vessel
DELETE {{baseUrl}}/api/vessels/{{vesselId}}

###

# ── Payloads ──────────────────────────────────────────────────────────────────

### List payloads
GET {{baseUrl}}/api/payloads?page=1&pageSize=20

###

### Get payload
GET {{baseUrl}}/api/payloads/{{mbesId}}

###

### Create MBES payload
POST {{baseUrl}}/api/payloads
Content-Type: application/json

{
  "payloadId": "mbes-001",
  "displayName": "Kongsberg EM 2040",
  "payloadType": "MBES",
  "manufacturer": "Kongsberg",
  "model": "EM 2040",
  "serialNumber": "EM2040-SN-8821",
  "label": "hull-center"
}

###

### Create PDU payload
POST {{baseUrl}}/api/payloads
Content-Type: application/json

{
  "payloadId": "pdu-001",
  "displayName": "APC PDU Survey Rack",
  "payloadType": "PDU",
  "manufacturer": "APC",
  "model": "AP8841",
  "serialNumber": "AP8841-SN-0042",
  "label": "survey-rack-port"
}

###

### Create INS payload
POST {{baseUrl}}/api/payloads
Content-Type: application/json

{
  "payloadId": "ins-001",
  "displayName": "Applanix POS MV",
  "payloadType": "INS",
  "manufacturer": "Applanix",
  "model": "POS MV WaveMaster II",
  "serialNumber": "POSMV-SN-5577",
  "label": "survey-rack-starboard"
}

###

### Update payload
PUT {{baseUrl}}/api/payloads/{{mbesId}}
Content-Type: application/json

{
  "displayName": "Kongsberg EM 2040 (updated)",
  "manufacturer": "Kongsberg",
  "model": "EM 2040C",
  "serialNumber": "EM2040-SN-8821",
  "label": "hull-center"
}

###

### Delete payload
DELETE {{baseUrl}}/api/payloads/{{mbesId}}

###

# ── Customers ─────────────────────────────────────────────────────────────────

### List customers
GET {{baseUrl}}/api/customers?page=1&pageSize=20

###

### Get customer
GET {{baseUrl}}/api/customers/{{customerId}}

###

### Create customer
POST {{baseUrl}}/api/customers
Content-Type: application/json

{
  "name": "Oceanic Surveys Ltd",
  "taxNumber": "GB987654321",
  "billingCountry": "GB",
  "billingCurrencyIso": "GBP",
  "parentId": null
}

###

### Update customer
PUT {{baseUrl}}/api/customers/{{customerId}}
Content-Type: application/json

{
  "name": "Oceanic Surveys Ltd (updated)",
  "taxNumber": null,
  "billingCountry": null,
  "billingCurrencyIso": null,
  "parentId": null
}

###

### Delete customer
DELETE {{baseUrl}}/api/customers/{{customerId}}

###

# ── Projects ──────────────────────────────────────────────────────────────────

### List projects
GET {{baseUrl}}/api/projects?page=1&pageSize=20

###

### Get project
GET {{baseUrl}}/api/projects/{{projectId}}

###

### Create project
POST {{baseUrl}}/api/projects
Content-Type: application/json

{
  "name": "North Sea Survey 2026",
  "customerId": {{customerId}},
  "region": "North Sea",
  "opStartDate": "2026-06-01",
  "opEndDate": "2026-09-30",
  "numVesselDays": 120,
  "projectType": "SURVEY",
  "projectStatus": "PLANNED",
  "pidSalesforce": null
}

###

### Update project status → ACTIVE
PUT {{baseUrl}}/api/projects/{{projectId}}/status
Content-Type: application/json

{
  "projectStatus": "ACTIVE"
}

###

### Update project status → COMPLETED
PUT {{baseUrl}}/api/projects/{{projectId}}/status
Content-Type: application/json

{
  "projectStatus": "COMPLETED"
}

###

### Delete project
DELETE {{baseUrl}}/api/projects/{{projectId}}

###

# ── Vessel Allocations ────────────────────────────────────────────────────────

### List allocations for project
GET {{baseUrl}}/api/projects/{{projectId}}/allocations

###

### Get allocation
GET {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}

###

### Create allocation
POST {{baseUrl}}/api/projects/{{projectId}}/allocations
Content-Type: application/json

{
  "vesselId": "{{vesselId}}",
  "role": "PRIMARY",
  "startDate": "2026-06-01",
  "endDate": "2026-09-30"
}

###

### Delete allocation
DELETE {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}

###

# ── Allocated Equipment ───────────────────────────────────────────────────────

### List equipment on allocation
GET {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}/equipment

###

### Add MBES to allocation
POST {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}/equipment
Content-Type: application/json

{
  "payloadId": "mbes-001",
  "mountLocation": "hull-center",
  "usage": "PRIMARY",
  "desiredHardwareParams": null
}

###

### Add PDU to allocation
POST {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}/equipment
Content-Type: application/json

{
  "payloadId": "pdu-001",
  "mountLocation": "survey-rack-port",
  "usage": "PRIMARY",
  "desiredHardwareParams": null
}

###

### Add INS to allocation
POST {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}/equipment
Content-Type: application/json

{
  "payloadId": "ins-001",
  "mountLocation": "survey-rack-starboard",
  "usage": "PRIMARY",
  "desiredHardwareParams": null
}

###

### Remove equipment (by id)
DELETE {{baseUrl}}/api/projects/{{projectId}}/allocations/{{allocationId}}/equipment/1

###

# ── Commands ──────────────────────────────────────────────────────────────────

### Issue MBES command
POST {{baseUrl}}/api/commands/mbes
Content-Type: application/json

{
  "payloadId": "mbes-001",
  "vesselId": "{{vesselId}}",
  "issuedBy": "operator@oi.com",
  "frequencyKhz": 300.0,
  "beamAngleDeg": 130.0,
  "angleCorrectionDeg": 0.0,
  "operatingMode": "EQUIDISTANT",
  "powerLevel": "NORMAL"
}

###

### Issue PDU command
POST {{baseUrl}}/api/commands/pdu
Content-Type: application/json

{
  "payloadId": "pdu-001",
  "vesselId": "{{vesselId}}",
  "issuedBy": "operator@oi.com",
  "outletIndex": 1,
  "action": "ON",
  "sequenceDelayS": null
}

###

### Issue INS command
POST {{baseUrl}}/api/commands/ins
Content-Type: application/json

{
  "payloadId": "ins-001",
  "vesselId": "{{vesselId}}",
  "issuedBy": "operator@oi.com",
  "action": "ALIGN"
}

###

# ── Readings ──────────────────────────────────────────────────────────────────

### Latest readings for all sensors on vessel
GET {{baseUrl}}/api/readings/payload/latest?vesselId={{vesselId}}

###

### Latest reading for specific MBES payload
GET {{baseUrl}}/api/readings/payload/latest?payloadId={{mbesId}}

###

### Latest reading for specific PDU payload
GET {{baseUrl}}/api/readings/payload/latest?payloadId={{pduId}}

###

### Latest MBES reading per payload for vessel
GET {{baseUrl}}/api/readings/mbes/latest?vesselId={{vesselId}}

###

### Latest PDU reading per payload for vessel
GET {{baseUrl}}/api/readings/pdu/latest?vesselId={{vesselId}}

###

### MBES time-series (most recent 20)
GET {{baseUrl}}/api/readings/mbes?limit=20

###

### MBES time-series by payload (cursor)
GET {{baseUrl}}/api/readings/mbes?payloadId={{mbesId}}&limit=20

###

### MBES time-series by vessel (cursor)
GET {{baseUrl}}/api/readings/mbes?vesselId={{vesselId}}&limit=20

###

### MBES time-series next page (paste before= from previous nextCursor)
GET {{baseUrl}}/api/readings/mbes?payloadId={{mbesId}}&before=2026-06-15T12:00:00Z&limit=20

###

# ── Reference Data ────────────────────────────────────────────────────────────

### Vessel types
GET {{baseUrl}}/api/reference/vessel-types

###

### Payload types
GET {{baseUrl}}/api/reference/payload-types

###

### Project types
GET {{baseUrl}}/api/reference/project-types

###

### Project statuses
GET {{baseUrl}}/api/reference/project-statuses

###

### Allocation actions
GET {{baseUrl}}/api/reference/allocation-actions
