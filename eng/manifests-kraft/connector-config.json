{
  "name": "outbox-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "database.hostname": "${file:/opt/kafka/external-configuration/postgres-credentials/hostname}",
    "database.port": "${file:/opt/kafka/external-configuration/postgres-credentials/port}",
    "database.user": "${file:/opt/kafka/external-configuration/postgres-credentials/username}",
    "database.password": "${file:/opt/kafka/external-configuration/postgres-credentials/password}",
    "database.dbname": "messaging_outbox",
    "topic.prefix": "messaging_outbox",
    "slot.name": "debezium_outbox_slot",
    "publication.name": "debezium_outbox_pub",
    "plugin.name": "pgoutput",
    "table.include.list": "public.outbox",
    "heartbeat.interval.ms": "5000",
    "tombstones.on.delete": "false",
    "snapshot.mode": "never",
    "transforms": "outbox",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "aggregateid",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.table.field.event.type": "type",
    "transforms.outbox.route.by.field": "aggregatetype",
    "transforms.outbox.table.fields.additional.placement": "type:header:eventType",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "io.confluent.connect.protobuf.ProtobufConverter",
    "value.converter.schema.registry.url": "${file:/opt/kafka/external-configuration/kafka-credentials/schema-registry-url}",
    "value.converter.schemas.enable": "false",
    "value.converter.auto.register.schemas": "true",
    "value.converter.subject.name.strategy": "io.confluent.kafka.serializers.subject.TopicNameStrategy",
    "errors.tolerance": "none",
    "errors.log.enable": "true",
    "errors.log.include.messages": "true"
  }
}