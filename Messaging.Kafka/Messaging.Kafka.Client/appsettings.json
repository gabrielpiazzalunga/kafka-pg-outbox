{
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "Postgres": {
    "ConnectionString": "Host=localhost;Database=messaging_outbox;Username=postgres;Password=postgres"
  },
  "Kafka": {
    "Connection": {
      "BootstrapServer": "localhost:29092",
      "SchemaRegistryUrl": "http://localhost:8081",
      "SaslUsername": ".",
      "SaslPassword": "."
    },
    "ProducerConfig": {
      "ClientName": "messaging-kafka-client",
      "ProduceTimeout": 20,
      "LingerMs": 5
    },
    "Resilience": {
      "Timeout": { "Timeout": 30 },
      "Retry": { "MaxRetryAttempts": 3, "Delay": 2 },
      "CircuitBreaker": {
        "SamplingDuration": 60,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "BreakDuration": 30
      }
    },
    "SampleEventConsumerConfig": {
      "TopicPattern": "sample-events-protobuf.events",
      "ConsumerGroupId": "messaging-kafka-client.sample-events",
      "AutoOffsetReset": "Latest",
      "ConcurrentMessageLimit": 10
    }
  }
}
