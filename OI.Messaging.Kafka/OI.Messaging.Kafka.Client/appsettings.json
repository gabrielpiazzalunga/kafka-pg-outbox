{
  "Logging": {
    "LogLevel": {
      "Default": "Error"
    }
  },
  "Kafka": {
    "Connection": {
      "BootstrapServer": "localhost:29092",
      "SchemaRegistryUrl": "http://localhost:8081",
      "SaslUsername": ".",
      "SaslPassword": "."
    },
    "ProducerConfig": {
      "ClientName": "oi-messaging-kafka-client",
      "ProduceTimeout": 20,
      "LingerMs": 5
    },
    "Resilience": {
      "Timeout": { "Timeout": 30 },
      "Retry": { "MaxRetryAttempts": 3, "Delay": 2 },
      "CircuitBreaker": {
        "SamplingDuration": 60,
        "FailureRatio": 0.5,
        "MinimumThroughput": 5,
        "BreakDuration": 30
      }
    },
    "MBESReadingEventConsumerConfig": {
      "TopicPattern": "localdev.MBESReadingEvent",
      "ConsumerGroupId": "oi-messaging-kafka-client.mbes-event",
      "AutoOffsetReset": "Latest",
      "ConcurrentMessageLimit": 10
    },
    "MBESReadingConsumerConfig": {
      "TopicPattern": "localdev.vessel.readings.mbes",
      "ConsumerGroupId": "oi-messaging-kafka-client.mbes-reading",
      "AutoOffsetReset": "Latest",
      "ConcurrentMessageLimit": 5
    },
    "INSReadingConsumerConfig": {
      "TopicPattern": "localdev.vessel.readings.ins",
      "ConsumerGroupId": "oi-messaging-kafka-client.ins-reading",
      "AutoOffsetReset": "Latest",
      "ConcurrentMessageLimit": 5
    }
  }
}
